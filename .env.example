# =====================================================================
# SIBERHARIAN (CSIRT DISKOMINFO JAWA TIMUR) - ENVIRONMENT CONFIGURATION
# =====================================================================

# 1. Kunci API Google Gemini (Wajib untuk inferensi AI, perangkuman, dan embeddings)
# Dapatkan kunci API resmi Anda di: https://aistudio.google.com/app/apikey
# Catatan: Anda dapat memasukkan lebih dari satu key (pisahkan tanda koma) untuk rotasi otomatis
# Contoh: GEMINI_API_KEY=AIzaSyD...,AIzaSyE...
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Konfigurasi Server Web (Opsional)
HOST=0.0.0.0
PORT=8000

# 3. Rahasia Sesi Web (WAJIB)
# Gunakan nilai acak minimal 32 karakter. Aplikasi menolak berjalan bila kosong.
SESSION_SECRET=ganti_dengan_rahasia_acak_minimal_32_karakter

# 4. Kredensial Akun Superadmin Awal (WAJIB untuk database baru)
# Hanya dipakai saat tabel admin_users masih kosong.
# Database yang sudah memiliki akun tidak terpengaruh perubahan variabel ini.
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=ganti_dengan_password_kuat

# 5. Akun Viewer Opsional (dibuat hanya bila VIEWER_PASSWORD diisi)
VIEWER_PASSWORD=

# 6. Lokasi Basis Data (Opsional; default data/state.db)
# SIBERHARIAN_DB_PATH=data/state.db
